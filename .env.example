# Local PostgreSQL connection. Create the database/user described in README.md.
DATABASE_URL=postgresql+psycopg://config_monitor:config_monitor@localhost:5432/config_monitor
CONFIG_ROOT=./config_samples
WEBHOOK_URL=http://127.0.0.1:9001/webhook
# Optional bearer token for authenticated webhook endpoints
# WEBHOOK_BEARER_TOKEN=replace-me
POLL_INTERVAL_SECONDS=5
DEBOUNCE_SECONDS=0.4
FULL_HASH_INTERVAL_SECONDS=60
WORKER_POLL_SECONDS=1
WEBHOOK_TIMEOUT_SECONDS=5
MAX_DELIVERY_ATTEMPTS=5
RETRY_BASE_SECONDS=1
RETRY_MAX_SECONDS=60
JOB_LEASE_SECONDS=30
LOG_LEVEL=INFO
